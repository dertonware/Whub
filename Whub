local function getSavedConfigs()
    local configs = {"Default"}
    if typeof(listfiles) == "function" and typeof(isfolder) == "function" and isfolder(CONFIG_FOLDER) then
        local files = listfiles(CONFIG_FOLDER)
        for _, path in ipairs(files) do
            local filename = path:match("([^/\\]+)%.json$")
            if filename and filename ~= "Default" then
                table.insert(configs, filename)
            end
        end
    end
    return configs
end

local configDropdown = SettingsTab:Dropdown({
    Title = "Saved Configs",
