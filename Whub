_G.WHub_Unload = function()
    State.AutoDig = false
    State.AutoClean = false
    State.AutoSell = false
    State.FastDig = false
    State.WalkSpeedEnabled = false
    State.TreasureESP = false

    for _, conn in ipairs(Connections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(Connections)
    
    clearESP()
    pcall(function() ESPFolder:Destroy() end)
    
    pcall(function()
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = 16 end
    end)
    
    pcall(function() WButtonGui:Destroy() end)
    
    if _G.WHub_Window then
        pcall(function() _G.WHub_Window:Destroy() end)
        _G.WHub_Window = nil
    end
    
    pcall(function()
        local hui = (gethui and gethui()) or game:GetService("CoreGui")
        for _, c in ipairs(hui:GetDescendants()) do
            if (c:IsA("ScreenGui") or c:IsA("Folder")) and (c.Name:find("WindUI") or c.Name:find("WHub")) then
                pcall(function() c:Destroy() end)
            end
        end
        local pgui = LocalPlayer:FindFirstChild("PlayerGui")
        if pgui then
            for _, c in ipairs(pgui:GetDescendants()) do
                if (c:IsA("ScreenGui") or c:IsA("Folder")) and (c.Name:find("WindUI") or c.Name:find("WHub")) then
                    pcall(function() c:Destroy() end)
                end
            end
        end
    end)
    
    _G.WHub_Unload = nil
    _G.WHub_UpdateEspDistance = nil
    print("[WHub] Successfully unloaded.")
end

