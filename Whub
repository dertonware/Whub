                else
                    local esp = ActiveESP[id]
                    esp.RichLabel.Text = string.format('<b><font color="%s">%s</font></b>  <font color="#d5e2f2">%dm</font>', hexColor, formattedRarity, distance)
                    esp.PillStroke.Color = rarityColor
                    esp.Indicator.BackgroundColor3 = rarityColor
                end
            end
        end
    end

    for id, espData in pairs(ActiveESP) do
        if not currentVisibleIds[id] then
            if espData.Billboard then pcall(function() espData.Billboard:Destroy() end) end
            if espData.Attachment then pcall(function() espData.Attachment:Destroy() end) end
            ActiveESP[id] = nil
        end
    end
end

task.spawn(function()
    while true do
        task.wait(0.2)
        if State.TreasureESP then
            pcall(updateESP)
        else
            if next(ActiveESP) ~= nil then
                clearESP()
            end
        end
    end
end)


