sellFilteredInventory = function(isAuto)
    if State.CleanBeforeSell and cleanAllDirtyItems then
        cleanAllDirtyItems()
        task.wait(0.15)
    end

    if State.AutoSellRarity == "Everything" then
        return sellAllInventory()
