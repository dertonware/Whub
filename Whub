            AutoSellRarity = State.AutoSellRarity,
            TreasureESP = State.TreasureESP,
            SelectedEspRarities = State.SelectedEspRarities,
            EspMaxDistance = State.EspMaxDistance,
            WalkSpeedEnabled = State.WalkSpeedEnabled,
            WalkSpeedValue = State.WalkSpeedValue,
            AntiAFK = State.AntiAFK,
            GuiKeybind = State.GuiKeybind.Name,
            SelectedIsland = State.SelectedIsland
        }
        
        local json = HttpService:JSONEncode(dataToSave)
        local filePath = CONFIG_FOLDER .. "/" .. currentConfigName .. ".json"
        
        if typeof(writefile) == "function" then
            writefile(filePath, json)
            safeNotify({
                Title = "Config Saved",
                Description = "Saved: " .. currentConfigName .. ".json",
                Duration = 2.5
            })
        else
            safeNotify({Title = "Error", Description = "writefile is not supported", Duration = 2.5})
        end
    end
})

SettingsTab:Button({
    Title = "Load Selected Config",
    Description = "Load configuration from selected file",
    Callback = function()
        local filePath = CONFIG_FOLDER .. "/" .. currentConfigName .. ".json"
        if typeof(readfile) == "function" and typeof(isfile) == "function" and isfile(filePath) then
            local content = readfile(filePath)
            local s, data = pcall(function() return HttpService:JSONDecode(content) end)
            if s and typeof(data) == "table" then
                for k, v in pairs(data) do
                    if k == "GuiKeybind" then
                        pcall(function() State.GuiKeybind = Enum.KeyCode[v] end)
                    elseif k == "SelectedEspRarities" then
                        if typeof(v) == "table" then
                            State.SelectedEspRarities = v
                            rebuildEspLookup()
                            pcall(function() espRarityDropdown:Select(v) end)
                        end
                    elseif k == "SelectedAutoDigRarities" then
                        if typeof(v) == "table" then
                            State.SelectedAutoDigRarities = v
                            rebuildAutoDigLookup()
                            pcall(function() autoDigDropdown:Select(v) end)
                        end
                    else
                        State[k] = v
                    end
                end
                safeNotify({
                    Title = "Config Loaded",
                    Description = "Loaded from: " .. currentConfigName,
                    Duration = 2.5
                })
            else
                safeNotify({Title = "Error", Description = "Corrupted JSON format", Duration = 2.5})
            end
        else
            safeNotify({Title = "Not Found", Description = "Config file does not exist", Duration = 2.5})
        end
    end
})

