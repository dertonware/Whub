-- Capacity detection
local function isBackpackFull()
    local s, full = pcall(function()
        local data = DataController and (DataController:getDataIfLoaded() or DataController:getData())
        if data and BackpackCapacity then
            return BackpackCapacity.isFull(data)
        end
        return false
    end)
    if s and full ~= nil then return full end
    
    local toolCount = 0
    for _, item in ipairs(LocalPlayer.Backpack:GetChildren()) do
        if item:IsA("Tool") and item:GetAttribute("inventoryId") then
            toolCount = toolCount + 1
        end
    end
    return toolCount >= 50
end

