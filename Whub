-- [[ CLEANING SYSTEM ]]
local function cleanItem(invId)
    local s, res = pcall(function()
        return ItemsNetwork.ItemsFunctions.beginCleaning:invoke(invId):expect()
    end)
    task.wait(0.09)
    pcall(function()
        ItemsNetwork.ItemsEvents.finishCleaning:fire(invId)
    end)
    task.wait(0.08)
    return s
end

local function getOrderedDirtyItems()
    local dirtyUids = {}
    local seen = {}
    
    -- Exact sequential inventory order from DataController (matches hotbar/inventory UI slots strictly from left to right)
    local data = DataController and (DataController:getDataIfLoaded() or DataController:getData())
    if data and data.Inventory then
        for _, item in ipairs(data.Inventory) do
            if not item.pedestalSlot and item.dirty == true and item.uid and not seen[item.uid] then
                seen[item.uid] = true
                table.insert(dirtyUids, item.uid)
            end
        end
    end
    
    -- Also check equipped tool (Character) and Backpack in case data hasn't synced yet
    local function checkContainer(container)
        if not container then return end
        for _, t in ipairs(container:GetChildren()) do
            if t:IsA("Tool") and t:GetAttribute("dirty") == true then
                local uid = t:GetAttribute("inventoryId") or t.Name
                if uid and not seen[uid] then
                    seen[uid] = true
                    table.insert(dirtyUids, uid)
                end
            end
        end
    end
    
    checkContainer(LocalPlayer.Character)
    checkContainer(LocalPlayer.Backpack)
    
    return dirtyUids
end

cleanAllDirtyItems = function()
    local totalCleaned = 0
    
    -- Up to 3 passes to guarantee 100% of dirty items are cleaned
    for pass = 1, 3 do
        local dirtyUids = getOrderedDirtyItems()
        if #dirtyUids == 0 then break end
        
        for _, invId in ipairs(dirtyUids) do
            local success = cleanItem(invId)
            if success then
                totalCleaned = totalCleaned + 1
            end
            task.wait(0.1)
        end
        
        task.wait(0.2)
    end
    
    return totalCleaned
end

-- Auto Clean background loop (cleans sequentially in inventory order)
task.spawn(function()
    while true do
        task.wait(0.6)
        if State.AutoClean then
            pcall(function()
                local dirtyUids = getOrderedDirtyItems()
                for _, invId in ipairs(dirtyUids) do
                    if not State.AutoClean then break end
                    cleanItem(invId)
                    task.wait(0.1)
                end
            end)
        end
    end
end)


