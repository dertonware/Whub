    local UI = {}
    UI.__index = UI
    
    function UI.new()
        local self = setmetatable({}, UI)
        self.gui = nil
        self._connections = {}
        return self
    end
    
    UI.createUI = function(self)
        local UIFactory = loadUIFactory()
        local uiBuilder = UIFactory(Colors, Players, TweenService, UserInputService, Lighting)
        uiBuilder(self)
        
        local targetGui = (gethui and gethui()) or game:GetService("CoreGui")
        self.gui.Parent = targetGui
        
        self.elements.getLinkButton.MouseButton1Click:Connect(function()
            self:handleGetLink()
        end)
        
        self.elements.verifyButton.MouseButton1Click:Connect(function()
            self:handleVerifyKey()
        end)
        
        self.elements.keyInput.FocusLost:Connect(function(enterPressed)
            if enterPressed then self:handleVerifyKey() end
        end)
        
        return self.gui
    end
    
    function UI:updateStatus(message, color, duration)
        if not self.elements then return end
        local st = self.elements.statusText
        local sb = self.elements.statusBar
        if st then
            st.Text = message
            st.TextColor3 = color or Colors.textSecondary
            st.Visible = true
            if sb then sb.BackgroundColor3 = color or Colors.border end
            if duration and duration > 0 then
                task.delay(duration, function()
                    if st and st.Text == message then
                        st.Visible = false
                        if sb then sb.BackgroundColor3 = Colors.border end
                    end
                end)
            end
        end
    end
    
    function UI:close()
        getgenv().UI_CLOSED = true
        local blur = Lighting:FindFirstChild("WHubUIBlur")
        if blur then blur:Destroy() end
        if self.gui then self.gui:Destroy() end
        self.gui = nil
        return getgenv().SCRIPT_KEY
    end
    
    function UI:handleGetLink()
        local link = Junkie.get_key_link()
        if link then
            if setclipboard then
                setclipboard(link)
                self:updateStatus("LootLabs link copied to clipboard!", Colors.success, 4)
            else
                self:updateStatus("Link: " .. tostring(link), Colors.primary, 10)
            end
        else
            self:updateStatus("Could not fetch LootLabs link", Colors.error, 3)
        end
    end
    
    function UI:handleVerifyKey()
        local key = self.elements.keyInput.Text:gsub("%s+", "")
        if key == "" then
            self:updateStatus("Please enter a key", Colors.error, 3)
            return
        end
        
        self:updateStatus("Verifying key with LootLabs...", Colors.primary, 0)
        local check = Junkie.check_key(key)
        
        if check and check.valid then
            saveVerifiedKey(key)
            self:updateStatus("Key Verified! Loading WHub...", Colors.success, 0)
            task.wait(0.8)
            getgenv().SCRIPT_KEY = key
            self:close()
        else
            self:updateStatus("Invalid or expired key. Get a new one via Get Key Link!", Colors.error, 4)
        end
    end

    local ui = UI.new()
    ui:createUI()

    -- Check if player already has an unexpired key saved locally
    local savedKey = loadVerifiedKey() or getgenv().SCRIPT_KEY
    if savedKey then
        local check = Junkie.check_key(savedKey)
        if check and check.valid then
            getgenv().SCRIPT_KEY = savedKey
            if ui.close then ui:close() end
            return savedKey
        else
            clearSavedKey()
        end
    end

    while not getgenv().UI_CLOSED do
        task.wait(0.1)
    end
    return getgenv().SCRIPT_KEY
